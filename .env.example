# ---------------------------------------------------------------------------
# Home Services Platform — backend configuration template
#
# Copy to `backend/.env` and fill in real values:
#
#     cp .env.example backend/.env
#
# `.env` is git-ignored. NEVER commit a filled-in copy, and never paste a real
# secret into this file — every value below is a placeholder.
#
# Where the values come from: Supabase Dashboard → your project →
#   • Database → Connection string  (reset the password under Database → Settings)
#   • Settings → API                (project URL, publishable/anon key, service_role key)
# ---------------------------------------------------------------------------

# --------------------------------------------------------------------- app
ENVIRONMENT=development
DEBUG=false
APP_NAME="Home Services Platform API"
CORS_ALLOW_ORIGINS=*

# ---------------------------------------------------------------- database
#
# Supabase PostgreSQL via psycopg 3. Copy the exact style from
# Supabase -> Project Settings -> Database -> Connection:
#
#   Direct (port 5432) — lowest latency, but one connection per worker:
#     postgresql+psycopg://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
#     db.<ref>.supabase.co is IPv6-only on many projects. From an IPv4-only
#     network this times out with no DNS error to explain it.
#
#   Session pooler (port 5432 on the pooler host) — use this when the direct host
#     is unreachable:
#     postgresql+psycopg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
#
#   Transaction pooler (port 6543) — when several API workers share one project,
#     since each worker holds its own pool:
#     postgresql+psycopg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
#
# `<DB_PASSWORD>` is the database password, NOT the service-role key. URL-encode
# it if it contains special characters. `sslmode=require` is mandatory for
# Supabase; startup refuses to run in production without it.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:CHANGE_ME@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

SQL_ECHO=false

# Pooling. `DB_POOL_SIZE + DB_MAX_OVERFLOW` is the most PostgreSQL connections a
# single API process may hold. Keep the total across all workers under your
# plan's connection limit, or switch to the transaction pooler (port 6543).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
# Recycle pooled connections before Supabase drops them as idle.
DB_POOL_RECYCLE_SECONDS=600
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_APPLICATION_NAME=home-services-api

# Only applied when DATABASE_URL carries no `sslmode` of its own.
DB_SSLMODE=

# --------------------------------------------------------------- security
#
# REQUIRED IN PRODUCTION. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Startup aborts if this is left at its built-in development value while
# ENVIRONMENT=production.
JWT_SECRET=CHANGE_ME_generate_with_python_-c_import_secrets_print_secrets_token_urlsafe_48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=720
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ------------------------------------------------------- verification email
#
# The sign-in code is sent by email (never SMS). Leaving SMTP_HOST empty is
# supported: the code is written to the API log instead, which is what lets a
# fresh clone complete a sign-in without any mail credentials. Fill these in to
# deliver real mail — for Gmail use an App Password from a 2FA-enabled account.
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your_app_password
#
# A send failure fails the request, so a code is never "sent" to nowhere.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15
# RFC 5322 sender; defaults to SMTP_USER when empty.
EMAIL_FROM=
EMAIL_FROM_NAME="Home Services"

# ---------------------------------------------------------------- supabase
#
# Supabase supplies PostgreSQL and private object storage here. It is NOT the
# identity provider: the platform keeps its own OTP/JWT flow, so
# SUPABASE_AUTH_ENABLED must stay false. Enabling it would introduce a second,
# conflicting identity system.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable ("anon") key. Safe to expose, and NOT needed by the mobile app:
# the Flutter client talks only to FastAPI. Listed for completeness and for
# future server-side calls that must respect RLS rather than bypass it.
SUPABASE_PUBLISHABLE_KEY=

# SERVICE ROLE KEY — bypasses Row Level Security and every Storage policy.
# SERVER-SIDE ONLY. It must never reach Flutter, a browser bundle, a log line,
# or this repository. Rotate it in the Supabase dashboard if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy alias for SUPABASE_PUBLISHABLE_KEY. Prefer the name above.
SUPABASE_ANON_KEY=

# Media buckets. Private, never public. The first path segment selects the
# bucket; see backend/app/integrations/supabase/storage.py for the mapping.
#   request-media/*    -> request-media
#   chat-media/*       -> chat-media
#   payment-proofs/*   -> payment-proofs
#   complaint-media/*  -> complaint-media
SUPABASE_STORAGE_BUCKET=request-media
SUPABASE_STORAGE_TIMEOUT_SECONDS=30

# Must stay false. See above.
SUPABASE_AUTH_ENABLED=false

# ------------------------------------------------------------------ media
# Uploads are validated by magic bytes, not by the declared MIME type.
MAX_UPLOAD_BYTES=12582912
MAX_IMAGE_DIMENSION=6000
MAX_IMAGES_PER_REQUEST=8
# Signed-URL lifetime, reserved for a future direct-to-storage flow.
SIGNED_URL_TTL_SECONDS=900

# Fallback private storage used only when Supabase is unconfigured. Must live
# outside any web root.
STORAGE_ROOT=./var/storage
# Leave empty: media is streamed through authorised FastAPI routes, never from a
# public URL.
STORAGE_PUBLIC_BASE_URL=

# ------------------------------------------------------------- rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_OTP=5/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_MEDIA=40/hour
RATE_LIMIT_CHAT=60/minute
RATE_LIMIT_COMPLAINT=5/hour
RATE_LIMIT_AI=20/minute
RATE_LIMIT_PAYMENT_PROOF=10/hour

# -------------------------------------------------------------- geocoding
# Address search is proxied through the backend to keep one identifying
# User-Agent and one request/second, per the OSM usage policy.
GEOCODER_ENABLED=true
GEOCODER_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="HomeServicesPlatform/1.0 (ops@example.com)"
NOMINATIM_TIMEOUT_SECONDS=8
GEOCODE_COUNTRY_CODES=eg

# ---------------------------------------------------------------------- ai
# Optional. Disabled by default; the platform works without it.
AI_PROVIDER=none
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------ firebase
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# ------------------------------------------------------------------- seed
# Only read by `python -m app.db.seed --demo`. Leave the password empty to have
# a random one generated and printed once.
SEED_ADMIN_PHONE=+201000000000
SEED_ADMIN_PASSWORD=

SUPPORT_PHONE=+201000000000

# ---------------------------------------------------------------------------
# The Flutter app needs NONE of the above. It only receives an API base URL at
# build time:
#
#     flutter build apk --dart-define=API_BASE_URL=https://api.example.com
#
# It must never receive the database URL, the JWT secret, or the service-role
# key.
# ---------------------------------------------------------------------------