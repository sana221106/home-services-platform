    {
      "parameters": {
        "jsCode": "const ci = $input.first().json.campaignInfo;\nconst leads = $input.first().json.leads;\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst phoneRegex = /^\\+[1-9]\\d{6,14}$/;\n\nconst cleanedLeads = leads.map((lead) => {\n  const fullName = (lead.full_name || '').trim();\n  const email = (lead.email || '').trim().toLowerCase();\n  let phone = (lead.phone || '').trim();\n  const status = (lead.status || '').trim().toLowerCase();\n  const score = Number(lead.score) || 0;\n\n  if (phone.startsWith('01') && phone.length === 11) {\n    phone = '+20' + phone;\n  }\n\n  const reasons = [];\n  if (status !== 'active') reasons.push('inactive_status');\n  if (!(score >= 50)) reasons.push('low_score');\n  if (!fullName) reasons.push('missing_name');\n  if (!emailRegex.test(email)) reasons.push('invalid_email');\n  if (!phoneRegex.test(phone)) reasons.push('missing_phone');\n\n  return {\n    lead_id: lead.lead_id || '',\n    full_name: fullName,\n    email: email,\n    phone: phone,\n    status: status,\n    score: score,\n    isValid: reasons.length === 0,\n    rejectionReasons: reasons\n  };\n});\n\nreturn [{\n  json: {\n    campaign_info: {\n      campaign_id: ci.campaign_id,\n      campaign_name: ci.campaign_name,\n      utm_source: ci.utm_source || '',\n      utm_medium: ci.utm_medium || ''\n    },\n    leads: cleanedLeads\n  }\n}];"
      },
