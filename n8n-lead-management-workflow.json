    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet campaignId = '';\nlet campaignName = '';\nlet total = items.length;\nlet valid = 0, invalid = 0, created = 0, updated = 0, failed = 0;\n\nfor (const it of items) {\n  const j = it.json;\n  if (!j) continue;\n\n  if (j.campaign_info) {\n    campaignId = j.campaign_info.campaign_id || campaignId;\n    campaignName = j.campaign_info.campaign_name || campaignName;\n  }\n\n  if (j.isValid === false) {\n    invalid++;\n  } else {\n    valid++;\n    if (j.operation === 'CREATED') created++;\n    else if (j.operation === 'UPDATED') updated++;\n    else failed++;\n  }\n}\n\nif (!campaignId) {\n  const f = items.find((i) => i.json && i.json.campaign_id);\n  if (f) {\n    campaignId = f.json.campaign_id;\n    campaignName = f.json.campaign_name;\n  }\n}\n\nreturn [{\n  json: {\n    campaign_id: campaignId,\n    campaign_name: campaignName,\n    total_leads: total,\n    valid_leads: valid,\n    invalid_leads: invalid,\n    created_leads: created,\n    updated_leads: updated,\n    failed_leads: failed,\n    execution_time: new Date().toISOString()\n  }\n}];"
      },
