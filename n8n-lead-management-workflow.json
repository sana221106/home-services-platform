    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nif (!body || typeof body !== 'object') {\n  return [{\n    json: {\n      isValid: false,\n      error: 'Invalid request payload',\n      message: 'Request body is missing or not valid JSON'\n    }\n  }];\n}\n\nif (body.event_type !== 'lead_submission') {\n  return [{\n    json: {\n      isValid: false,\n      error: 'Invalid event type',\n      message: 'event_type must be \"lead_submission\"'\n    }\n  }];\n}\n\nconst ci = body.campaign_info;\nif (!ci || !ci.campaign_id || !ci.campaign_name) {\n  return [{\n    json: {\n      isValid: false,\n      error: 'Invalid campaign info',\n      message: 'campaign_info with campaign_id and campaign_name is required'\n    }\n  }];\n}\n\nconst leads = body.leads;\nif (!Array.isArray(leads) || leads.length === 0) {\n  return [{\n    json: {\n      isValid: false,\n      error: 'Invalid request payload',\n      message: 'campaign_info and a non-empty leads array are required'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    isValid: true,\n    eventType: body.event_type,\n    campaignInfo: ci,\n    leads: leads\n  }\n}];"
      },
